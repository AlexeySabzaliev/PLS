# Flask
FLASK_APP=run.py
FLASK_ENV=development
# Слушать все интерфейсы — доступ с других ПК в LAN (flask run / python run.py)
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
SECRET_KEY=change-me-in-production

# PostgreSQL (docker-compose up -d postgres)
DATABASE_URL=postgresql://pls:pls@localhost:5432/pls
# Без PostgreSQL — SQLite: sqlite:///instance/pls.db

# Каталог резервных копий (flask pls backup / restore)
PLS_BACKUP_DIR=backups
# Сколько последних копий хранить (0 = не удалять автоматически)
PLS_BACKUP_RETENTION=30

# Dev-заглушки (только при FLASK_ENV != production)
# PLS_SSO_STUB=1          # вход без IIS/OIDC: SSO_ENABLED + SSO_DEV_IDENTITY=admin
# SECURITY_PORTAL_STUB=1  # демо-заявки охраны без security.bsh-ru.ru
# SECURITY_USE_MOCK=1     # то же, альтернативное имя
#
# Страницы-заглушки (работают с обычной авторизацией):
#   /uznt/, /uznt/requests, /uznt/tenders, /uznt/analytics
#   /uss/, /uss/reports
# API заглушек разделов: POST /api/maintenance (admin)

# Админ при flask pls init-db
PLS_ADMIN_EMAIL=admin@bsh-ru.ru
PLS_ADMIN_PASSWORD=admin
PLS_TRANSPORT_EMAIL=transport@bsh-ru.ru
PLS_TRANSPORT_PASSWORD=transport

# Регистрация на главной (роль «Просмотр отчётов»); админ — сброс пароля и роли
# PLS_REGISTRATION_ENABLED=true
# PLS_REGISTRATION_EMAIL_DOMAIN=bsh-ru.ru

# SSO (Windows / IIS Remote-User) — устарело для входа в ПЛС
SSO_ENABLED=false
SSO_MODE=headers
SSO_ALLOW_WINDOWS_FALLBACK=true
SSO_USER_HEADER=Remote-User
SSO_EMAIL_DOMAIN=bsh-ru.ru
SSO_ALLOW_PASSWORD_LOGIN=true
# Dev bypass (только при FLASK_ENV != production)
SSO_DEV_IDENTITY=

# OIDC (опционально)
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_REDIRECT_URI=
SSO_OIDC_SCOPE=openid email profile

# Биллинг — путь к эталонным Excel (вне репозитория)
ARISTON_BILLING_FIXTURES_PATH=

# Импорт из Billings (одноразовый, insert-only)
# BILLINGS_DATABASE_URL=postgresql://user:pass@localhost/billings
# PLS_FREEZE_REFERENCE=1   # не перезаписывать справочники seed/fix-ariston

# Портал охраны (security.bsh-ru.ru) — заявки на въезд ТС
# См. docs/SECURITY_PORTAL.md — это SSO **сервера**, не вход пользователя в ПЛС.
#
# --- prod (Windows/IIS, учётка службы) ---
# SECURITY_AUTH_MODE=negotiate
# SECURITY_USE_NEGOTIATE=true
# SECURITY_AUTO_BROWSER_COOKIES=0
# SECURITY_USE_LOCAL_DB=0
#
# --- dev / тесты (временно) ---
# SECURITY_BASE_URL=https://security.bsh-ru.ru
# SECURITY_USE_LOCAL_DB=1           # кэш security_admission_form + live-портал
# SECURITY_OFFLINE_ONLY=1           # только локальный кэш, без запросов к порталу
# SECURITY_LOCAL_FALLBACK=1         # fallback на локальную копию при ошибке SSO
# SECURITY_AUTH_MODE=browser        # dev: cookies Yandex/Edge на ПК разработчика
# flask pls security-refresh-session
# flask pls security-fetch-portal
# flask pls security-import-sql
# У склада в справочнике задайте security_visit_place («Место визита СБ»)
